# 公共配置模板：复制/同步到 .env 后按自己的环境填写。
# 服务商、模型与密钥由使用者填写；.env 不提交。修改后重启后端。
# 未选择服务商时仍可管理课程，但模型相关功能会提示尚未配置。

# ===== 对话模型 =====
# 可选：deepseek / qwen / zhipu / moonshot / openai / siliconflow / ollama
CHAT_PROVIDER=
# Ollama 必填已安装的完整模型标签（用 ollama list 查看）。
# 云服务可填写模型名，留空使用代码注册表中的该服务商默认模型。
CHAT_MODEL=

# ===== 嵌入模型（资料入库、语义检索）=====
# 可选：siliconflow / zhipu / qwen / openai / ollama；与对话服务独立选择。
# 云端嵌入会发送资料文本片段和检索问题，可能产生费用。
EMBEDDING_PROVIDER=
# Ollama 必填已安装的嵌入模型标签；云服务可留空使用注册表默认模型。
# 切换嵌入模型后需重新处理资料，不能混用向量空间。
EMBEDDING_MODEL=

# ===== Ollama 地址（仅选择 ollama 时使用）=====
# 通用本机地址，不代表已安装服务或模型；对话地址不含 /v1。
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 嵌入使用 OpenAI 兼容接口，需包含 /v1；可独立配置。
OLLAMA_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1

# ===== 可选重排 =====
# 可选：none / siliconflow / jina / cohere；none 表示关闭。
RERANK_PROVIDER=none
RERANK_MODEL=

# ===== API Key（只填已选择服务商的密钥，其余留空）=====
# DeepSeek：https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# 阿里云百炼：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
# 智谱：https://open.bigmodel.cn/
ZHIPU_API_KEY=
# 月之暗面：https://platform.moonshot.cn/
MOONSHOT_API_KEY=
# OpenAI：https://platform.openai.com/
OPENAI_API_KEY=
# 硅基流动：https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=
# Jina：https://jina.ai/
JINA_API_KEY=
# Cohere：https://dashboard.cohere.com/
COHERE_API_KEY=

# ===== 回答超时 =====
# 整轮超时（秒），留空：Ollama 600，其他服务商 180。
RUN_TIMEOUT=

# ===== 检索与分块 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=100
# 默认参考片段数，页面可调整；Agent 最多采用 4。
TOP_K=4

# ===== 本地数据 =====
# 留空使用项目 data/；自定义时填写绝对目录，不提交数据库与资料。
COURSE_AGENT_DATA_DIR=
